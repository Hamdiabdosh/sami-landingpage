POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sami_showcase

BETTER_AUTH_SECRET=change-me-long-random-string-min-32-chars
BETTER_AUTH_URL=https://sami.raafat.site
SITE_URL=https://sami.raafat.site
BETTER_AUTH_TRUSTED_ORIGINS=https://sami.raafat.site,http://sami.raafat.site

ADMIN_EMAIL=admin@sami.et
ADMIN_PASSWORD=change-me-after-deploy
RUN_SEED=true

# Coolify: set POSTGRES_* + auth vars only — do NOT set DATABASE_URL (built at container start).
# After password mismatch (P1000): stop app, delete pgdata volume, redeploy with RUN_SEED=true.
# Local reset: npm run docker:reset-db
