# Database (local dev — start with: docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/sami_showcase"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:8080"
# Public site URL for SEO (canonical, og:image, sitemap). Defaults to BETTER_AUTH_URL.
SITE_URL="http://localhost:8080"
# Comma-separated extra origins for production (e.g. https://sami.raafat.site)
BETTER_AUTH_TRUSTED_ORIGINS=""

# Admin seed credentials (used by prisma/seed.ts only)
ADMIN_EMAIL="admin@sami.et"
ADMIN_PASSWORD="sami2026"

# Local image uploads (converted to WebP). Default: ./data/uploads
# UPLOAD_DIR="./data/uploads"

# Production / Coolify — see .env.production.example and docker-compose.yml
