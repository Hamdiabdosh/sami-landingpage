# Copy to Coolify environment variables (or .env for docker compose)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sami_showcase

BETTER_AUTH_SECRET=change-me-long-random-string-at-least-32-chars
BETTER_AUTH_URL=https://sami.raafat.site
BETTER_AUTH_TRUSTED_ORIGINS=https://sami.raafat.site,http://sami.raafat.site

ADMIN_EMAIL=admin@sami.et
ADMIN_PASSWORD=change-me-after-first-login
RUN_SEED=true

# Optional — image uploads via Cloudinary (omit to store data URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
